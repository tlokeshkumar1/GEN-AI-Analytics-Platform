# SAP AI Core Configuration
AICORE_AUTH_URL=https://<auth-url>/oauth/token
AICORE_CLIENT_ID=your-client-id
AICORE_CLIENT_SECRET=your-client-secret
AICORE_RESOURCE_GROUP=default
AICORE_BASE_URL=https://<base-url>/v2

# SAP HANA Cloud Database Configuration
HANA_ADDRESS=your-hana-instance.hanadb.ondemand.com
HANA_PORT=443
HANA_USER=DBADMIN
HANA_PASSWORD=your-hana-password
HANA_SCHEMA=your-schema

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
# Existing self-service defaults; opt into stricter review/sharing only when desired.
PLATFORM_CHAT_WORKSPACE_ACCESS=true
PLATFORM_AUTO_APPROVE_SEMANTICS=true
PLATFORM_CATEGORICAL_NULL_POLICY=label
# Custom Python charts require this image on a Docker-capable runtime.
PLATFORM_CHART_IMAGE=
